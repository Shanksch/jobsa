{
  "manifest_version": 3,
  "name": "JobSA — AI Job Application Copilot",
  "description": "Intelligently autofill job applications across ATS platforms with AI-powered matching and human review.",
  "version": "0.1.0",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [

    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": false,
      "js": ["src/content/widget.ts"]
    },
    {
      "matches": [
        "https://jobsa-web-dashboard.vercel.app/*",
        "http://localhost:5173/*"
      ],
      "js": ["src/content/auth-sync.ts"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://jobsa-backend.onrender.com/*",
    "http://localhost:8000/*",
    "https://xhnzyznqeojaqqzutdfp.supabase.co/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
