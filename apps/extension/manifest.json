{
  "manifest_version": 3,
  "name": "JobSA — AI Job Application Copilot",
  "description": "Intelligently autofill job applications across ATS platforms with AI-powered matching and human review.",
  "version": "0.1.4",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://careers.smartrecruiters.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://jobs.jobvite.com/*",
        "https://*.jobvite.com/*",
        "https://*.bamboohr.com/*",
        "https://app.jazz.co/*",
        "https://*.applytojob.com/*",
        "https://apply.workable.com/*",
        "https://jobs.workable.com/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.breezy.hr/*",
        "https://*.recruitee.com/*",
        "https://*.jobs.personio.com/*",
        "https://*.teamtailor.com/*",
        "https://*.csod.com/*",
        "https://*.avature.net/*",
        "https://*.ultipro.com/*",
        "https://workforcenow.adp.com/*",
        "https://*.bullhornstaffing.com/*"
      ],
      "all_frames": true,
      "js": [
        "content/detect-form.js",
        "src/content/widget.ts"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://34.41.44.108:8000/*",
    "http://localhost:8000/*",
    "https://xhnzyznqeojaqqzutdfp.supabase.co/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://jobsa-web-dashboard.vercel.app/*",
      "http://localhost:5173/*"
    ]
  }
}