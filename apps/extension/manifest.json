{
  "manifest_version": 3,
  "name": "JobSA — AI Job Application Copilot",
  "description": "Intelligently autofill job applications across ATS platforms with AI-powered matching and human review.",
  "version": "0.1.0",
  "icons": {
    "16": "public/logo.png",
    "48": "public/logo.png",
    "128": "public/logo.png"
  },
  "action": {
    "default_icon": {
      "16": "public/logo.png",
      "48": "public/logo.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": ["src/content/index.ts"]
    },
    {
      "matches": [
        "https://jobsa-web-dashboard.vercel.app/*",
        "http://localhost:5173/*"
      ],
      "js": ["src/content/auth-sync.ts"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://jobsa-backend.onrender.com/*",
    "http://localhost:8000/*",
    "https://xhnzyznqeojaqqzutdfp.supabase.co/*"
  ]
}
