# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jobsa:jobsa_dev@localhost:5432/jobsa
DATABASE_URL_SYNC=postgresql://jobsa:jobsa_dev@localhost:5432/jobsa

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── LLM (via LiteLLM) ─────────────────────────────────────
# Provider: ollama | groq | openrouter | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434

# Groq (free tier — uncomment to switch)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here

# ─── Embeddings ─────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# ─── Auth (Supabase — Phase 1+) ────────────────────────────
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Backend ────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,chrome-extension://
LOG_LEVEL=DEBUG

# ─── Observability (Langfuse — Phase 8+) ───────────────────
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=your_public_key
# LANGFUSE_SECRET_KEY=your_secret_key
