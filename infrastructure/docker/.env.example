# Docker-specific environment variables
# Copy to .env and fill in your values

# ─── Database (local PostgreSQL for dev fallback) ─────────
POSTGRES_USER=jobsa
POSTGRES_PASSWORD=jobsa_dev
POSTGRES_DB=jobsa

# ─── Backend ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jobsa:jobsa_dev@postgres:5432/jobsa
DATABASE_URL_SYNC=postgresql://jobsa:jobsa_dev@postgres:5432/jobsa
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,chrome-extension://
LOG_LEVEL=DEBUG

# ─── LLM ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# ─── Supabase (optional — if not set, uses local storage) ─
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
