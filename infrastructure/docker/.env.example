# ─── Docker Environment Variables ───────────────────────────
# Copy this to .env in the same directory

# These are overridden by docker-compose.yml environment: section
# but serve as fallback defaults

DATABASE_URL=postgresql+asyncpg://jobsa:jobsa_dev@postgres:5432/jobsa
DATABASE_URL_SYNC=postgresql://jobsa:jobsa_dev@postgres:5432/jobsa
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://ollama:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://ollama:11434
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,chrome-extension://
LOG_LEVEL=DEBUG
